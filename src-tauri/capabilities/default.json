{
  "identifier": "default",
  "description": "Default capabilities for SysForge",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:allow-read",
    "fs:allow-write",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/sysforge/**" }
      ]
    }
  ]
}